# ARIA Vanguard backend — local dev environment (first iteration, will grow)
#
# Copy this file to `.env` in this same directory and fill in only what you need.
# Every setting below has a safe default — the backend boots fine with an EMPTY
# .env (or none at all): no Telegram, no LLM answers, no external writes. This
# file only lists the variables worth knowing about for a first local run; the
# full, authoritative list (~150+ settings) is `app/config.py` (Settings class).
#
# Never commit a real .env. This file (env.example) is the only version meant
# to be committed — it stays free of real secrets by design.

# --- Core ---
DEBUG=true
PORT=8000
SITE_BASE_URL=
DATA_DIR=

# --- Telegram bot (optional — leave empty to skip Telegram entirely) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_IDS=

# --- LLM provider (optional — leave empty for grounded/templated answers only) ---
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=

# --- Admin/session secrets (optional for local dev, required for a real deploy) ---
ADMIN_API_SECRET=
ACCESS_CODE_ENABLED=false
